<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kiis_testbed</name>
  <version>0.1.0</version>
  <description>autodrive_digital_twin — 컨트롤 패널(실제 구동계)과 Unity 디지털 트윈을 같은 ROS 2 명령으로 구동·비교하는 테스트베드 (autodrive_skku에서 teleop·브리지만 추림)</description>
  <maintainer email="yulee3542@gmail.com">Yulee3542</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-serial</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-matplotlib</exec_depend>  <!-- monitor_node(WSLg 창), twin/analyze.py -->
  <exec_depend>python3-tk</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
